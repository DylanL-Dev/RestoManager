{
  "name": "restomanager",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "RestoManager — réservations, salles, tables et synchronisation Supabase",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:mission2": "node --test tests/reservation-edit.test.cjs tests/booking-exterior-classification.test.cjs",
    "test:mission2:postgres": "node tests/postgres/mission2.cjs",
    "test:mission2:browser": "node tests/browser/mission2.cjs",
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "serve": "python3 -m http.server 8000",
    "test:mission3:postgres": "node tests/postgres/mission2.cjs --mission3",
    "test:mission3:browser": "node tests/browser/mission3.cjs",
    "test:mission3:supabase": "node tests/supabase/mission3.cjs",
    "test:syntax": "node tests/check-syntax.cjs",
    "test:display": "node tests/browser/table-display.cjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.57.0",
    "playwright": "1.56.1"
  }
}
