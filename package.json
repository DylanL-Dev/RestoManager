{
  "name": "restomanager",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "RestoManager — réservations, salles, tables et synchronisation Supabase",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:mission2": "node --test tests/reservation-edit.test.cjs tests/booking-exterior-classification.test.cjs",
    "test:mission2:postgres": "node tests/postgres/mission2.cjs",
    "test:mission2:browser": "node tests/browser/mission2.cjs",
    "test": "node --test tests/*.test.js tests/*.test.cjs",
    "serve": "python3 -m http.server 8000",
    "test:mission3:postgres": "node tests/postgres/mission2.cjs --mission3",
    "test:mission3:browser": "node tests/browser/mission3.cjs",
    "test:mission3:supabase": "node tests/supabase/mission3.cjs",
    "test:notifications:browser": "node tests/browser/rm014-notifications.cjs",
    "test:notifications:lifecycle": "node tests/browser/rm014-lifecycle.cjs",
    "test:notifications:pwa": "node tests/browser/rm014-pwa.cjs",
    "test:notifications:dismiss": "node tests/browser/rm014-dismiss.cjs",
    "test:assistance:browser": "node tests/browser/rm013a-assistance.cjs",
    "test:rm013a:browser": "node tests/browser/rm013a-management.cjs",
    "test:syntax": "node tests/check-syntax.cjs",
    "test:display": "node tests/browser/table-display.cjs",
    "test:audit:dev:postgres": "node tests/postgres/mission2.cjs --mission3 --dev-snapshot",
    "test:audit:dev:supabase": "node tests/supabase/mission3.cjs --dev-snapshot",
    "test:closeout:postgres": "node tests/postgres/rm012.cjs",
    "test:closeout:browser": "node tests/browser/rm012-closeout.cjs",
    "test:learning:browser": "node tests/browser/rm016-learning.cjs",
    "build:public-demo": "node scripts/build-public-demo.cjs",
    "test:public-demo:browser": "node tests/browser/rm015-public.cjs",
    "build:public-connected": "node scripts/build-public-connected.cjs",
    "test:public-connected:postgres": "node tests/postgres/rm015.cjs",
    "test:public-connected:browser": "node tests/browser/rm015-connected.cjs",
    "prepare:production": "node scripts/prepare-rm015-production.cjs",
    "test:public-sync:supabase": "node tests/supabase/mission3.cjs --rm015",
    "test:rm-ops:postgres": "node tests/postgres/rm-ops-engine.cjs --with-proposals"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.119.0",
    "axe-core": "4.10.3",
    "jsqr": "1.4.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "qrcode-generator": "1.4.4"
  }
}
